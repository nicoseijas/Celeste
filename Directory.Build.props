<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Do NOT set InvariantGlobalization here. WPF's font fallback builds CultureInfo objects by
      name (MS.Internal.FontCache.MajorLanguages), which throws CultureNotFoundException in
      globalization-invariant mode. It only fails on the text that reaches the fallback path, so
      the app crashes on one screen rather than at startup.
    -->
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Product>Celeste</Product>
    <Authors>Celeste contributors</Authors>
    <Company>Celeste</Company>
    <Copyright>Copyright (c) Celeste contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/nicoseijas/Celeste</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nicoseijas/Celeste.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Label="Symbols">
    <!--
      A .snupkg alongside the package, so a consumer stepping into Celeste gets real source instead of
      decompiled guesses. The SDK supplies Source Link for GitHub, and PublishRepositoryUrl above is
      what lets the debugger find the commit these binaries came from.
    -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
  </PropertyGroup>

</Project>
