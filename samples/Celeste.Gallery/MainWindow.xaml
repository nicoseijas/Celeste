<Window x:Class="Celeste.Gallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:celeste="https://celeste-ui.dev/wpf"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Celeste Gallery"
        Width="1040"
        Height="760"
        Style="{StaticResource Celeste.Window}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!--  The page a destination stands for. Deliberately taller than the host, so the scroll position has somewhere to go.  -->
        <DataTemplate x:Key="DemoPage">
            <StackPanel>
                <TextBlock Style="{StaticResource Celeste.TextBlock.Subtitle}" Text="{Binding}" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource Celeste.TextBlock.Muted}"
                           Text="Scroll down, pick another destination, then press Back: this page comes back where you left it, not at the top."
                           TextWrapping="Wrap" />

                <celeste:Card Margin="0,16,0,0" Header="Section one">
                    <TextBlock Height="140"
                               Style="{StaticResource Celeste.TextBlock.Muted}"
                               Text="Celeste keeps no navigation state of its own. The host watches its Content and records where the application has been."
                               TextWrapping="Wrap" />
                </celeste:Card>
                <celeste:Card Margin="0,12,0,0" Header="Section two">
                    <TextBlock Height="140"
                               Style="{StaticResource Celeste.TextBlock.Muted}"
                               Text="Forward is a fresh look at a page and starts at the top; only Back restores a position."
                               TextWrapping="Wrap" />
                </celeste:Card>
                <celeste:Card Margin="0,12,0,0" Header="Section three">
                    <TextBlock Height="140"
                               Style="{StaticResource Celeste.TextBlock.Muted}"
                               Text="The back stack is capped, so a session that runs for days does not hold on to every page it ever showed."
                               TextWrapping="Wrap" />
                </celeste:Card>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Style="{StaticResource Celeste.TextBlock.Title}" Text="Celeste" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource Celeste.TextBlock.Muted}"
                           Text="A modern, themeable UI library for WPF." />
            </StackPanel>

            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Celeste.TextBlock.Muted}"
                           Text="Theme" />
                <ComboBox x:Name="ThemeSelector"
                          Width="140"
                          SelectionChanged="OnThemeSelectionChanged">
                    <ComboBoxItem Content="System" />
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <TabControl x:Name="Sections" Grid.Row="1">

            <!--  ===========  Buttons  ===========  -->
            <TabItem Header="Buttons">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <celeste:Card Header="Variants" Description="Every button shares one template; only the color tokens differ.">
                            <WrapPanel ItemHeight="46">
                                <Button Margin="0,0,10,0" Content="Secondary" />
                                <Button Margin="0,0,10,0"
                                        Content="Primary"
                                        Style="{StaticResource Celeste.Button.Primary}" />
                                <Button Margin="0,0,10,0"
                                        Content="Destructive"
                                        Style="{StaticResource Celeste.Button.Destructive}" />
                                <Button Margin="0,0,10,0"
                                        Content="Outline"
                                        Style="{StaticResource Celeste.Button.Outline}" />
                                <Button Margin="0,0,10,0"
                                        Content="Ghost"
                                        Style="{StaticResource Celeste.Button.Ghost}" />
                                <Button Margin="0,0,10,0"
                                        Content="Link"
                                        Style="{StaticResource Celeste.Button.Link}" />
                                <Button Margin="0,0,10,0"
                                        Content="Disabled"
                                        IsEnabled="False" />
                            </WrapPanel>
                        </celeste:Card>

                        <celeste:Card Margin="0,16,0,0"
                                      Header="Sizes"
                                      Description="Small, default, and large share the same vertical rhythm.">
                            <StackPanel Orientation="Horizontal">
                                <Button Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Content="Small"
                                        Style="{StaticResource Celeste.Button.Small}" />
                                <Button Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Content="Default" />
                                <Button VerticalAlignment="Center"
                                        Content="Large"
                                        Style="{StaticResource Celeste.Button.Large}" />
                            </StackPanel>
                        </celeste:Card>

                        <celeste:Card Margin="0,16,0,0"
                                      Header="Toggles"
                                      Description="Segments for one choice out of several, ToggleButton for a choice that stands on its own, ToggleSwitch for a setting that applies the moment it changes.">
                            <StackPanel>
                                <StackPanel x:Name="RangeToggles" Orientation="Horizontal">
                                    <RadioButton Margin="0,0,8,0"
                                                 Content="Day"
                                                 GroupName="Range"
                                                 IsChecked="True"
                                                 Style="{StaticResource Celeste.ToggleButton.Segment}" />
                                    <RadioButton Margin="0,0,8,0"
                                                 Content="Week"
                                                 GroupName="Range"
                                                 Style="{StaticResource Celeste.ToggleButton.Segment}" />
                                    <RadioButton Content="Month"
                                                 GroupName="Range"
                                                 Style="{StaticResource Celeste.ToggleButton.Segment}" />
                                </StackPanel>
                                <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                                    <ToggleButton Margin="0,0,8,0"
                                                  Content="Show grid"
                                                  IsChecked="True" />
                                    <ToggleButton Margin="0,0,8,0" Content="Snap to edges" />
                                    <ToggleButton Content="Unavailable" IsEnabled="False" />
                                </StackPanel>

                                <celeste:ToggleSwitch Margin="0,16,0,0"
                                                      Content="Enable notifications"
                                                      IsChecked="True" />
                                <celeste:ToggleSwitch Margin="0,10,0,0" Content="Send anonymous usage data" />
                                <celeste:ToggleSwitch Margin="0,10,0,0"
                                                      Content="Unavailable on this plan"
                                                      IsEnabled="False" />
                            </StackPanel>
                        </celeste:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!--  ===========  Inputs  ===========  -->
            <TabItem Header="Inputs">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <celeste:Card Header="Text" Description="Placeholders come from an attached property, so they never leak into Text.">
                            <StackPanel>
                                <Label Content="Workspace name" Target="{Binding ElementName=NameBox}" />
                                <TextBox x:Name="NameBox" celeste:ControlHelper.PlaceholderText="e.g. Northwind" />

                                <Label Margin="0,14,0,0" Content="API token" />
                                <PasswordBox />

                                <Label Margin="0,14,0,0" Content="Notes" />
                                <TextBox celeste:ControlHelper.PlaceholderText="Anything the team should know…" Style="{StaticResource Celeste.TextBox.Multiline}" />

                                <Label Margin="0,14,0,0" Content="Read-only" />
                                <TextBox IsReadOnly="True" Text="Cannot be edited" />
                            </StackPanel>
                        </celeste:Card>

                        <celeste:Card Margin="0,16,0,0" Header="Choice">
                            <StackPanel>
                                <Label Content="Region" />
                                <ComboBox Width="240"
                                          HorizontalAlignment="Left"
                                          celeste:ControlHelper.PlaceholderText="Select a region">
                                    <ComboBoxItem Content="South America" />
                                    <ComboBoxItem Content="North America" />
                                    <ComboBoxItem Content="Europe" />
                                    <ComboBoxItem Content="Asia Pacific" />
                                </ComboBox>

                                <StackPanel Margin="0,16,0,0">
                                    <CheckBox Content="Ship weekly digest" IsChecked="True" />
                                    <CheckBox Margin="0,8,0,0" Content="Include draft items" />
                                    <CheckBox Margin="0,8,0,0"
                                              Content="Partially selected"
                                              IsChecked="{x:Null}"
                                              IsThreeState="True" />
                                    <CheckBox Margin="0,8,0,0"
                                              Content="Locked by policy"
                                              IsEnabled="False" />
                                </StackPanel>

                                <StackPanel Margin="0,16,0,0">
                                    <RadioButton Content="Automatic" IsChecked="True" />
                                    <RadioButton Margin="0,8,0,0" Content="Manual" />
                                    <RadioButton Margin="0,8,0,0"
                                                 Content="Scheduled"
                                                 IsEnabled="False" />
                                </StackPanel>
                            </StackPanel>
                        </celeste:Card>

                        <celeste:Card Margin="0,16,0,0" Header="Range">
                            <StackPanel>
                                <Slider Maximum="100"
                                        Minimum="0"
                                        Value="35" />
                                <Slider Margin="0,12,0,0"
                                        IsEnabled="False"
                                        Maximum="100"
                                        Value="70" />
                            </StackPanel>
                        </celeste:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!--  ===========  Display  ===========  -->
            <TabItem Header="Display">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <celeste:Card Header="Badges" Description="One template, six variants: only the color tokens and the text inside change.">
                            <WrapPanel>
                                <celeste:Badge Margin="0,0,8,0" Content="Neutral" />
                                <celeste:Badge Margin="0,0,8,0"
                                               Content="Primary"
                                               Variant="Primary" />
                                <celeste:Badge Margin="0,0,8,0"
                                               Content="Passing"
                                               Variant="Success" />
                                <celeste:Badge Margin="0,0,8,0"
                                               Content="Deprecated"
                                               Variant="Warning" />
                                <celeste:Badge Margin="0,0,8,0"
                                               Content="Failed"
                                               Variant="Danger" />
                                <celeste:Badge Content="Outline" Variant="Outline" />
                            </WrapPanel>
                        </celeste:Card>

                        <celeste:Card Margin="0,16,0,0"
                                      Header="Progress"
                                      Description="Determinate reports how far along the work is; indeterminate and the ring only say that it is happening.">
                            <StackPanel>
                                <ProgressBar Value="42" />
                                <ProgressBar Margin="0,12,0,0" IsIndeterminate="True" />
                                <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                                    <celeste:ProgressRing VerticalAlignment="Center" />
                                    <TextBlock Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource Celeste.TextBlock.Muted}"
                                               Text="Syncing workspace…" />
                                </StackPanel>
                            </StackPanel>
                        </celeste:Card>

                        <celeste:Card Margin="0,16,0,0"
                                      Header="Elevation"
                                      Description="Shadow depth, not a border, is what separates a card from the surface behind it.">
                            <StackPanel Orientation="Horizontal">
                                <celeste:Card Width="180"
                                              Margin="0,0,16,0"
                                              Content="Flat"
                                              Elevation="Flat" />
                                <celeste:Card Width="180"
                                              Margin="0,0,16,0"
                                              Content="Low"
                                              Elevation="Low" />
                                <celeste:Card Width="180"
                                              Content="High"
                                              Elevation="High" />
                            </StackPanel>
                        </celeste:Card>

                        <celeste:Card Margin="0,16,0,0"
                                      Header="Card with a footer"
                                      Description="Header, description, content, and footer are independent.">
                            <TextBlock Style="{StaticResource Celeste.TextBlock.Muted}"
                                       Text="Deleting a workspace removes every project inside it. This cannot be undone."
                                       TextWrapping="Wrap" />
                            <celeste:Card.Footer>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button Margin="0,0,8,0"
                                            Content="Cancel"
                                            Style="{StaticResource Celeste.Button.Ghost}" />
                                    <Button Content="Delete workspace" Style="{StaticResource Celeste.Button.Destructive}" />
                                </StackPanel>
                            </celeste:Card.Footer>
                        </celeste:Card>

                        <celeste:Card Margin="0,16,0,0"
                                      Header="List"
                                      Description="Selection follows the platform: click, arrow keys, and Ctrl/Shift-click all work without any wiring.">
                            <ListBox Height="160" SelectedIndex="2">
                                <ListBoxItem Content="analytics-service" />
                                <ListBoxItem Content="billing-worker" />
                                <ListBoxItem Content="edge-gateway" />
                                <ListBoxItem Content="identity-provider" />
                                <ListBoxItem Content="notification-relay" />
                                <ListBoxItem Content="search-indexer" />
                                <ListBoxItem Content="webhooks-dispatcher" IsEnabled="False" />
                            </ListBox>
                        </celeste:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!--  ===========  Typography  ===========  -->
            <TabItem Header="Typography">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <celeste:Card Header="Type scale"
                                      Description="Six sizes and three weights. The specimen is real text, because a label like &quot;Display 34&quot; hides what the letterforms do.">
                            <!--  Two columns: the token on the left, the size it produces on the right.  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock VerticalAlignment="Bottom"
                                           Style="{StaticResource Celeste.TextBlock.Caption}"
                                           Text="Display · 34 · SemiBold" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource Celeste.TextBlock.Display}"
                                           Text="Everything in its place" />

                                <TextBlock Grid.Row="1"
                                           Margin="0,18,0,0"
                                           VerticalAlignment="Bottom"
                                           Style="{StaticResource Celeste.TextBlock.Caption}"
                                           Text="Title · 24 · SemiBold" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Margin="0,18,0,0"
                                           Style="{StaticResource Celeste.TextBlock.Title}"
                                           Text="Workspace settings" />

                                <TextBlock Grid.Row="2"
                                           Margin="0,18,0,0"
                                           VerticalAlignment="Bottom"
                                           Style="{StaticResource Celeste.TextBlock.Caption}"
                                           Text="Subtitle · 18 · SemiBold" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Margin="0,18,0,0"
                                           Style="{StaticResource Celeste.TextBlock.Subtitle}"
                                           Text="Notifications and delivery" />

                                <TextBlock Grid.Row="3"
                                           Margin="0,18,0,0"
                                           VerticalAlignment="Bottom"
                                           Style="{StaticResource Celeste.TextBlock.Caption}"
                                           Text="Strong · 13 · SemiBold" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Margin="0,18,0,0"
                                           Style="{StaticResource Celeste.TextBlock.Strong}"
                                           Text="Three members still need to accept the invitation." />

                                <TextBlock Grid.Row="4"
                                           Margin="0,14,0,0"
                                           VerticalAlignment="Bottom"
                                           Style="{StaticResource Celeste.TextBlock.Caption}"
                                           Text="Body · 13 · Regular" />
                                <TextBlock Grid.Row="4"
                                           Grid.Column="1"
                                           Margin="0,14,0,0"
                                           Style="{StaticResource Celeste.TextBlock.Body}"
                                           Text="The reading size. Long paragraphs, dialog text, and anything the user has to take in word by word — 0123456789, «guillemets», em—dashes, and ﬁ ligatures included."
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="5"
                                           Margin="0,14,0,0"
                                           VerticalAlignment="Bottom"
                                           Style="{StaticResource Celeste.TextBlock.Caption}"
                                           Text="Muted · 13 · Regular" />
                                <TextBlock Grid.Row="5"
                                           Grid.Column="1"
                                           Margin="0,14,0,0"
                                           Style="{StaticResource Celeste.TextBlock.Muted}"
                                           Text="Same size as Body, lower contrast. For text that supports the line above it and must not compete with it."
                                           TextWrapping="Wrap" />

                                <TextBlock Grid.Row="6"
                                           Margin="0,14,0,0"
                                           VerticalAlignment="Bottom"
                                           Style="{StaticResource Celeste.TextBlock.Caption}"
                                           Text="Caption · 11 · Regular" />
                                <TextBlock Grid.Row="6"
                                           Grid.Column="1"
                                           Margin="0,14,0,0"
                                           Style="{StaticResource Celeste.TextBlock.Caption}"
                                           Text="LAST SYNCED 4 MINUTES AGO · 12 OF 40 SEATS USED" />
                            </Grid>
                        </celeste:Card>

                        <celeste:Card Margin="0,16,0,0"
                                      Header="Monospace"
                                      Description="Code renders with Display formatting, so stems stay on the pixel grid and columns line up.">
                            <Border Padding="14,12"
                                    Background="{DynamicResource Celeste.Brush.SurfaceSunken}"
                                    BorderBrush="{DynamicResource Celeste.Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Celeste.Radius.Md}">
                                <!--  Separate blocks, not LineBreak: XAML would collapse the indentation into a leading space on every line.  -->
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Celeste.TextBlock.Code}" Text="ThemeManager.Apply(ApplicationTheme.Dark);" />
                                    <TextBlock Style="{StaticResource Celeste.TextBlock.Code}" Text="ThemeManager.Apply(ApplicationTheme.System);" />
                                    <TextBlock Margin="0,14,0,0"
                                               Style="{StaticResource Celeste.TextBlock.Code}"
                                               Text="// 0O1lI — the shapes a proportional face confuses." />
                                </StackPanel>
                            </Border>
                        </celeste:Card>

                        <celeste:Card Margin="0,16,0,0"
                                      Header="In context"
                                      Description="The same styles doing their real job: one hierarchy, read top to bottom.">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Celeste.TextBlock.Caption}" Text="RELEASE 0.3.0 · 10 AUGUST 2026" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource Celeste.TextBlock.Title}"
                                           Text="Navigation, end to end" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource Celeste.TextBlock.Muted}"
                                           Text="A sidebar that collapses to a rail, a host that picks its own display mode, and a back stack that remembers where each page was left."
                                           TextWrapping="Wrap" />

                                <TextBlock Margin="0,20,0,0"
                                           Style="{StaticResource Celeste.TextBlock.Subtitle}"
                                           Text="Breaking changes" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource Celeste.TextBlock.Strong}"
                                           Text="SidebarHost no longer opens its own pane." />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource Celeste.TextBlock.Body}"
                                           Text="The application decides where the toggle lives and routes TogglePaneCommand to it. Applications that relied on the built-in button must add one to their chrome."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </celeste:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!--  ===========  Navigation  ===========  -->
            <TabItem Header="Navigation">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <celeste:Card Header="Sidebar"
                                      Description="Selection is the only navigation state the control owns — bind SelectedItem and route it yourself.">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                                    <celeste:ToggleSwitch x:Name="CollapseToggle" Content="Collapse to the rail" />
                                    <TextBlock Margin="20,0,0,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource Celeste.TextBlock.Muted}"
                                               Text="The header chevron does the same thing — IsCollapsed binds two ways." />
                                </StackPanel>

                                <Border Height="430"
                                        BorderBrush="{DynamicResource Celeste.Brush.Border}"
                                        BorderThickness="1"
                                        ClipToBounds="True"
                                        CornerRadius="{DynamicResource Celeste.Radius.Md}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <celeste:Sidebar x:Name="DemoSidebar"
                                                         BorderThickness="0,0,1,0"
                                                         Header="Acme"
                                                         IsCollapsed="{Binding IsChecked, ElementName=CollapseToggle}"
                                                         SelectedIndex="1">
                                            <!--  The rail is 56px wide: the name gives way to a mark.  -->
                                            <celeste:Sidebar.CollapsedHeader>
                                                <Path Width="20"
                                                      Height="20"
                                                      Data="M10,0 L20,10 L10,20 L0,10 Z M10,5.5 L4.5,10 L10,14.5 L15.5,10 Z"
                                                      Fill="{DynamicResource Celeste.Brush.Primary}" />
                                            </celeste:Sidebar.CollapsedHeader>

                                            <celeste:SidebarGroupHeader Content="WORKSPACE" />

                                            <celeste:SidebarItem Content="Overview">
                                                <celeste:SidebarItem.Icon>
                                                    <Path Data="M1,1 H7 V7 H1 Z M11,1 H17 V7 H11 Z M1,11 H7 V17 H1 Z M11,11 H17 V17 H11 Z" Style="{StaticResource Celeste.SidebarItem.Icon}" />
                                                </celeste:SidebarItem.Icon>
                                            </celeste:SidebarItem>

                                            <celeste:SidebarItem Badge="12" Content="Reports">
                                                <celeste:SidebarItem.Icon>
                                                    <Path Data="M2,16 V9 M7,16 V3 M12,16 V11 M17,16 V6" Style="{StaticResource Celeste.SidebarItem.Icon}" />
                                                </celeste:SidebarItem.Icon>
                                            </celeste:SidebarItem>

                                            <celeste:SidebarItem Content="Members">
                                                <celeste:SidebarItem.Icon>
                                                    <Path Data="M5.5,6 A3.5,3.5 0 1,0 12.5,6 A3.5,3.5 0 1,0 5.5,6 Z M2.5,16.5 A6.5,5 0 0,1 15.5,16.5" Style="{StaticResource Celeste.SidebarItem.Icon}" />
                                                </celeste:SidebarItem.Icon>
                                            </celeste:SidebarItem>

                                            <celeste:SidebarGroupHeader Content="ACCOUNT" />

                                            <celeste:SidebarItem Content="Billing">
                                                <celeste:SidebarItem.Icon>
                                                    <Path Data="M1.5,4.5 H16.5 V13.5 H1.5 Z M1.5,7.5 H16.5" Style="{StaticResource Celeste.SidebarItem.Icon}" />
                                                </celeste:SidebarItem.Icon>
                                            </celeste:SidebarItem>

                                            <!--  A separator where a group needs parting but not naming.  -->
                                            <celeste:SidebarSeparator />

                                            <celeste:SidebarItem Content="Archived" IsEnabled="False">
                                                <celeste:SidebarItem.Icon>
                                                    <Path Data="M1.5,3.5 H16.5 V7 H1.5 Z M3,7 V15.5 H15 V7 M7,10.5 H11" Style="{StaticResource Celeste.SidebarItem.Icon}" />
                                                </celeste:SidebarItem.Icon>
                                            </celeste:SidebarItem>

                                            <celeste:Sidebar.Footer>
                                                <celeste:SidebarItem Content="Settings">
                                                    <celeste:SidebarItem.Icon>
                                                        <Path Data="M5.5,9 A3.5,3.5 0 1,0 12.5,9 A3.5,3.5 0 1,0 5.5,9 Z M9,1.5 V4 M9,14 V16.5 M1.5,9 H4 M14,9 H16.5" Style="{StaticResource Celeste.SidebarItem.Icon}" />
                                                    </celeste:SidebarItem.Icon>
                                                </celeste:SidebarItem>
                                            </celeste:Sidebar.Footer>
                                        </celeste:Sidebar>

                                        <StackPanel Grid.Column="1"
                                                    Margin="24"
                                                    VerticalAlignment="Top">
                                            <TextBlock Style="{StaticResource Celeste.TextBlock.Subtitle}" Text="{Binding SelectedItem.Content, ElementName=DemoSidebar}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Style="{StaticResource Celeste.TextBlock.Muted}"
                                                       Text="Arrow keys move between destinations and step over group headers and separators. In the rail, the label becomes the tooltip."
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </celeste:Card>

                        <celeste:Card Margin="0,16,0,0"
                                      Header="Off-canvas and responsive"
                                      Description="SidebarHost reads its own width and picks docked, rail, or off-canvas. Drag the handle across the breakpoints.">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource Celeste.TextBlock.Muted}"
                                               Text="Available width" />
                                    <Slider x:Name="HostWidth"
                                            Width="260"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Maximum="940"
                                            Minimum="360"
                                            Value="900" />
                                    <TextBlock Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Text="{Binding ActualDisplayMode, ElementName=DemoHost}" />
                                </StackPanel>

                                <Border Width="{Binding Value, ElementName=HostWidth}"
                                        Height="380"
                                        HorizontalAlignment="Left"
                                        BorderBrush="{DynamicResource Celeste.Brush.Border}"
                                        BorderThickness="1"
                                        ClipToBounds="True"
                                        CornerRadius="{DynamicResource Celeste.Radius.Md}">
                                    <!--  Breakpoints scaled down to the demo box; the defaults assume a whole window.  -->
                                    <celeste:SidebarHost x:Name="DemoHost" OffCanvasBreakpoint="520" RailBreakpoint="760">
                                        <celeste:SidebarHost.Pane>
                                            <celeste:Sidebar x:Name="DemoHostSidebar"
                                                             BorderThickness="0,0,1,0"
                                                             Header="Acme"
                                                             IsToggleButtonVisible="False"
                                                             SelectedIndex="0">
                                                <celeste:Sidebar.CollapsedHeader>
                                                    <Path Width="20"
                                                          Height="20"
                                                          Data="M10,0 L20,10 L10,20 L0,10 Z M10,5.5 L4.5,10 L10,14.5 L15.5,10 Z"
                                                          Fill="{DynamicResource Celeste.Brush.Primary}" />
                                                </celeste:Sidebar.CollapsedHeader>

                                                <celeste:SidebarItem Content="Overview">
                                                    <celeste:SidebarItem.Icon>
                                                        <Path Data="M1,1 H7 V7 H1 Z M11,1 H17 V7 H11 Z M1,11 H7 V17 H1 Z M11,11 H17 V17 H11 Z" Style="{StaticResource Celeste.SidebarItem.Icon}" />
                                                    </celeste:SidebarItem.Icon>
                                                </celeste:SidebarItem>

                                                <celeste:SidebarItem Badge="12" Content="Reports">
                                                    <celeste:SidebarItem.Icon>
                                                        <Path Data="M2,16 V9 M7,16 V3 M12,16 V11 M17,16 V6" Style="{StaticResource Celeste.SidebarItem.Icon}" />
                                                    </celeste:SidebarItem.Icon>
                                                </celeste:SidebarItem>

                                                <celeste:SidebarItem Content="Members">
                                                    <celeste:SidebarItem.Icon>
                                                        <Path Data="M5.5,6 A3.5,3.5 0 1,0 12.5,6 A3.5,3.5 0 1,0 5.5,6 Z M2.5,16.5 A6.5,5 0 0,1 15.5,16.5" Style="{StaticResource Celeste.SidebarItem.Icon}" />
                                                    </celeste:SidebarItem.Icon>
                                                </celeste:SidebarItem>

                                                <celeste:SidebarItem Content="Billing">
                                                    <celeste:SidebarItem.Icon>
                                                        <Path Data="M1.5,4.5 H16.5 V13.5 H1.5 Z M1.5,7.5 H16.5" Style="{StaticResource Celeste.SidebarItem.Icon}" />
                                                    </celeste:SidebarItem.Icon>
                                                </celeste:SidebarItem>
                                            </celeste:Sidebar>
                                        </celeste:SidebarHost.Pane>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Border Padding="10,8"
                                                    BorderBrush="{DynamicResource Celeste.Brush.Border}"
                                                    BorderThickness="0,0,0,1">
                                                <StackPanel Orientation="Horizontal">
                                                    <!--  Celeste never opens the pane itself: the application decides where this button lives.  -->
                                                    <Button Command="{x:Static celeste:SidebarHost.TogglePaneCommand}" ToolTip="Show navigation">
                                                        <Button.Style>
                                                            <Style BasedOn="{StaticResource Celeste.Button.Ghost}" TargetType="{x:Type Button}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ActualDisplayMode, ElementName=DemoHost}" Value="OffCanvas">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Path Width="16"
                                                              Height="12"
                                                              Data="M0,1 H16 M0,6 H16 M0,11 H16"
                                                              Stroke="{DynamicResource Celeste.Brush.Foreground}"
                                                              StrokeThickness="1.6" />
                                                    </Button>

                                                    <TextBlock Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding SelectedItem.Content, ElementName=DemoHostSidebar}" />
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Grid.Row="1"
                                                       Margin="24"
                                                       VerticalAlignment="Top"
                                                       Style="{StaticResource Celeste.TextBlock.Muted}"
                                                       Text="Narrow enough and the pane leaves the layout. Opening it draws a scrim over this text, traps Tab inside the pane, and gives focus back when the scrim or Esc closes it."
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </celeste:SidebarHost>
                                </Border>
                            </StackPanel>
                        </celeste:Card>

                        <celeste:Card Margin="0,16,0,0"
                                      Header="Pages and history"
                                      Description="NavigationHost holds the page the sidebar selected, keeps a back stack, and puts each page back where you left it.">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                                    <!--  Outside the host, so it points at one: BrowseBack routes, and CommandTarget is how a button in the chrome reaches it.  -->
                                    <Button Command="NavigationCommands.BrowseBack"
                                            CommandTarget="{Binding ElementName=DemoNavigation}"
                                            Content="Back"
                                            Style="{StaticResource Celeste.Button.Outline}" />
                                    <TextBlock Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource Celeste.TextBlock.Muted}"
                                               Text="{Binding BackStackDepth, ElementName=DemoNavigation, StringFormat='{}{0} page(s) behind'}" />
                                </StackPanel>

                                <Border Height="360"
                                        BorderBrush="{DynamicResource Celeste.Brush.Border}"
                                        BorderThickness="1"
                                        ClipToBounds="True"
                                        CornerRadius="{DynamicResource Celeste.Radius.Md}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!--  Plain strings, so SelectedItem is the page itself and the binding below can run both ways.  -->
                                        <celeste:Sidebar x:Name="PagesSidebar"
                                                         BorderThickness="0,0,1,0"
                                                         ExpandedWidth="170"
                                                         IsToggleButtonVisible="False"
                                                         SelectedIndex="0">
                                            <celeste:Sidebar.ItemsSource>
                                                <x:Array Type="{x:Type sys:String}">
                                                    <sys:String>Overview</sys:String>
                                                    <sys:String>Reports</sys:String>
                                                    <sys:String>Members</sys:String>
                                                    <sys:String>Billing</sys:String>
                                                </x:Array>
                                            </celeste:Sidebar.ItemsSource>
                                        </celeste:Sidebar>

                                        <!--  TwoWay: Back writes the previous page here, and the sidebar has to follow it.  -->
                                        <celeste:NavigationHost x:Name="DemoNavigation"
                                                                Grid.Column="1"
                                                                Content="{Binding SelectedItem, ElementName=PagesSidebar, Mode=TwoWay}"
                                                                ContentTemplate="{StaticResource DemoPage}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </celeste:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!--  ===========  Media  ===========  -->
            <TabItem Header="Media">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <celeste:Card Header="Avatars"
                                      Description="Initials are the fallback: no picture yet, no picture set, or a picture that failed all look the same to the reader.">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <celeste:Avatar Margin="0,0,12,0"
                                                    Initials="NS"
                                                    Size="Small"
                                                    Source="Assets/person.png" />
                                    <celeste:Avatar Margin="0,0,12,0"
                                                    Initials="NS"
                                                    Source="Assets/person.png" />
                                    <celeste:Avatar Margin="0,0,24,0"
                                                    Initials="NS"
                                                    Size="Large"
                                                    Source="Assets/person.png" />

                                    <celeste:Avatar Margin="0,0,12,0" Initials="AB" />
                                    <celeste:Avatar Margin="0,0,12,0"
                                                    Initials="李"
                                                    Size="Large" />
                                    <!--  A source that cannot resolve, to show the fallback rather than an empty circle.  -->
                                    <celeste:Avatar Margin="0,0,12,0"
                                                    Initials="MK"
                                                    Source="Assets/does-not-exist.png" />
                                    <celeste:Avatar Initials="DZ" IsEnabled="False" />
                                </StackPanel>

                                <TextBlock Margin="0,14,0,0"
                                           Style="{StaticResource Celeste.TextBlock.Muted}"
                                           Text="Celeste does not shorten a name into initials for you. Which letters stand for a person depends on their language and their name order, and a two-letter rule that works in one script mangles another."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </celeste:Card>

                        <celeste:Card Margin="0,16,0,0"
                                      Header="ImageView"
                                      Description="A picture from a URI, decoded off the UI thread at the width it is shown at.">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,16,0">
                                        <celeste:ImageView Width="170"
                                                           Height="115"
                                                           Source="Assets/tile-4.png" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Style="{StaticResource Celeste.TextBlock.Caption}"
                                                   Text="LOADED" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,16,0">
                                        <celeste:ImageView Width="170"
                                                           Height="115"
                                                           Source="Assets/nothing-here.png" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Style="{StaticResource Celeste.TextBlock.Caption}"
                                                   Text="FAILED" />
                                    </StackPanel>

                                    <StackPanel>
                                        <celeste:ImageView Width="170" Height="115">
                                            <celeste:ImageView.Placeholder>
                                                <celeste:ProgressRing />
                                            </celeste:ImageView.Placeholder>
                                        </celeste:ImageView>
                                        <TextBlock Margin="0,6,0,0"
                                                   Style="{StaticResource Celeste.TextBlock.Caption}"
                                                   Text="NO SOURCE, OWN PLACEHOLDER" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Margin="0,18,0,8"
                                           Style="{StaticResource Celeste.TextBlock.Strong}"
                                           Text="Stretch, in a box that is not the picture's shape" />
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,16,0">
                                        <celeste:ImageView Width="150"
                                                           Height="150"
                                                           Source="Assets/tile-4.png"
                                                           Stretch="UniformToFill" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Style="{StaticResource Celeste.TextBlock.Caption}"
                                                   Text="UNIFORMTOFILL — CROPS" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <celeste:ImageView Width="150"
                                                           Height="150"
                                                           Source="Assets/tile-4.png"
                                                           Stretch="Uniform" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Style="{StaticResource Celeste.TextBlock.Caption}"
                                                   Text="UNIFORM — LETTERBOXES" />
                                    </StackPanel>
                                    <StackPanel>
                                        <celeste:ImageView Width="150"
                                                           Height="150"
                                                           Source="Assets/tile-4.png"
                                                           Stretch="Fill" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Style="{StaticResource Celeste.TextBlock.Caption}"
                                                   Text="FILL — DISTORTS" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </celeste:Card>

                        <celeste:Card Margin="0,16,0,0"
                                      Header="Masonry"
                                      Description="Every tile goes into the column that is shortest at the time. The numbers are the order they are declared in — which is not the order you read them in, and that is the trade.">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource Celeste.TextBlock.Muted}"
                                               Text="Available width" />
                                    <Slider x:Name="MasonryWidth"
                                            Width="240"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Maximum="900"
                                            Minimum="260"
                                            Value="900" />
                                    <TextBlock Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource Celeste.TextBlock.Muted}"
                                               Text="MinColumnWidth is 200, so the column count follows the width." />
                                </StackPanel>

                                <!--  The panel sizes itself from the width it is given; the border is only there to show where that ends.  -->
                                <Border Width="{Binding Value, ElementName=MasonryWidth}"
                                        Padding="12"
                                        HorizontalAlignment="Left"
                                        BorderBrush="{DynamicResource Celeste.Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Celeste.Radius.Md}">
                                    <celeste:MasonryPanel ColumnSpacing="12"
                                                          MinColumnWidth="200"
                                                          RowSpacing="12">
                                        <celeste:ImageView Source="Assets/tile-1.png" />
                                        <celeste:ImageView Source="Assets/tile-2.png" />
                                        <celeste:ImageView Source="Assets/tile-3.png" />
                                        <celeste:ImageView Source="Assets/tile-4.png" />

                                        <!--  Not an image: the panel arranges whatever decides its own height.  -->
                                        <celeste:Card Header="Any content" Elevation="Low">
                                            <TextBlock Style="{StaticResource Celeste.TextBlock.Muted}"
                                                       Text="A masonry column is a column. Anything that measures to a height of its own belongs in one."
                                                       TextWrapping="Wrap" />
                                        </celeste:Card>

                                        <celeste:ImageView Source="Assets/tile-5.png" />
                                        <celeste:ImageView Source="Assets/tile-6.png" />
                                        <celeste:ImageView Source="Assets/tile-7.png" />
                                        <celeste:ImageView Source="Assets/tile-8.png" />
                                    </celeste:MasonryPanel>
                                </Border>
                            </StackPanel>
                        </celeste:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
