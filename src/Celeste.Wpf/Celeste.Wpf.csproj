<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <RootNamespace>Celeste.Wpf</RootNamespace>
    <AssemblyName>Celeste.Wpf</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <IsPackable>true</IsPackable>
    <PackageId>Celeste.Wpf</PackageId>
    <Version>0.2.0-alpha.1</Version>
    <Description>A modern, themeable UI library for WPF: semantic design tokens, light/dark themes, restyled native controls, and the controls WPF never shipped.</Description>
    <PackageTags>wpf;ui;xaml;theme;dark-mode;controls;design-system;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--
      Checks the packed package rather than the compiled assemblies: that every target framework it
      claims offers the same public API, and that nothing in lib is unreachable. Two frameworks built
      from one source should agree, and the day they stop agreeing is the day a consumer on the other
      one finds out.
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
