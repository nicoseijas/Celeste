<!--
    Celeste — dark theme color tokens.

    Every key defined here MUST also exist in Light.xaml. See the note in Light.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="Celeste.ThemeName">Dark</sys:String>

    <!--  Surfaces  -->
    <Color x:Key="Celeste.Color.Background">#FF0B0F14</Color>
    <Color x:Key="Celeste.Color.Foreground">#FFE9EDF2</Color>
    <Color x:Key="Celeste.Color.Surface">#FF121821</Color>
    <Color x:Key="Celeste.Color.SurfaceForeground">#FFE9EDF2</Color>
    <Color x:Key="Celeste.Color.SurfaceRaised">#FF18202B</Color>
    <Color x:Key="Celeste.Color.SurfaceSunken">#FF080B0F</Color>

    <!--  Primary action  -->
    <Color x:Key="Celeste.Color.Primary">#FF5B9DFF</Color>
    <Color x:Key="Celeste.Color.PrimaryHover">#FF7BB0FF</Color>
    <Color x:Key="Celeste.Color.PrimaryPressed">#FF4A86E0</Color>
    <Color x:Key="Celeste.Color.PrimaryForeground">#FF07101C</Color>

    <!--  Secondary action  -->
    <Color x:Key="Celeste.Color.Secondary">#FF1A222C</Color>
    <Color x:Key="Celeste.Color.SecondaryHover">#FF222C38</Color>
    <Color x:Key="Celeste.Color.SecondaryPressed">#FF2A3542</Color>
    <Color x:Key="Celeste.Color.SecondaryForeground">#FFE9EDF2</Color>

    <!--  Destructive action  -->
    <Color x:Key="Celeste.Color.Destructive">#FFF05252</Color>
    <Color x:Key="Celeste.Color.DestructiveHover">#FFF87171</Color>
    <!--
        Pressed is darker than the base, as everywhere else, but only so far: the foreground on a
        destructive button in this theme is nearly black, so darkening the background is what takes
        the contrast down. At #D03B3B the pressed state read 4.06:1.
    -->
    <Color x:Key="Celeste.Color.DestructivePressed">#FFDC4C4C</Color>
    <Color x:Key="Celeste.Color.DestructiveForeground">#FF1A0707</Color>

    <!--  Status  -->
    <Color x:Key="Celeste.Color.Success">#FF4ADE80</Color>
    <Color x:Key="Celeste.Color.SuccessForeground">#FF04140A</Color>
    <Color x:Key="Celeste.Color.Warning">#FFFBBF24</Color>
    <Color x:Key="Celeste.Color.WarningForeground">#FF1A1204</Color>

    <!--  Subtle emphasis  -->
    <Color x:Key="Celeste.Color.Accent">#FF16273D</Color>
    <Color x:Key="Celeste.Color.AccentForeground">#FFBBD6FF</Color>
    <Color x:Key="Celeste.Color.Muted">#FF1A222C</Color>
    <Color x:Key="Celeste.Color.MutedForeground">#FF94A3B8</Color>

    <!--  Lines and inputs  -->
    <Color x:Key="Celeste.Color.Border">#FF232C38</Color>
    <Color x:Key="Celeste.Color.BorderStrong">#FF33404F</Color>
    <Color x:Key="Celeste.Color.Input">#FF2A3542</Color>
    <Color x:Key="Celeste.Color.InputHover">#FF3D4B5C</Color>
    <Color x:Key="Celeste.Color.Ring">#FF5B9DFF</Color>

    <!--  Disabled  -->
    <Color x:Key="Celeste.Color.Disabled">#FF161D26</Color>
    <Color x:Key="Celeste.Color.DisabledForeground">#FF5A6675</Color>
    <Color x:Key="Celeste.Color.DisabledBorder">#FF222B36</Color>

    <!--  Scrims and shadows  -->
    <Color x:Key="Celeste.Color.Overlay">#99000000</Color>
    <Color x:Key="Celeste.Color.Shadow">#FF000000</Color>

    <!--  Brushes  -->
    <SolidColorBrush x:Key="Celeste.Brush.Background" Color="{StaticResource Celeste.Color.Background}" />
    <SolidColorBrush x:Key="Celeste.Brush.Foreground" Color="{StaticResource Celeste.Color.Foreground}" />
    <SolidColorBrush x:Key="Celeste.Brush.Surface" Color="{StaticResource Celeste.Color.Surface}" />
    <SolidColorBrush x:Key="Celeste.Brush.SurfaceForeground" Color="{StaticResource Celeste.Color.SurfaceForeground}" />
    <SolidColorBrush x:Key="Celeste.Brush.SurfaceRaised" Color="{StaticResource Celeste.Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="Celeste.Brush.SurfaceSunken" Color="{StaticResource Celeste.Color.SurfaceSunken}" />

    <SolidColorBrush x:Key="Celeste.Brush.Primary" Color="{StaticResource Celeste.Color.Primary}" />
    <SolidColorBrush x:Key="Celeste.Brush.PrimaryHover" Color="{StaticResource Celeste.Color.PrimaryHover}" />
    <SolidColorBrush x:Key="Celeste.Brush.PrimaryPressed" Color="{StaticResource Celeste.Color.PrimaryPressed}" />
    <SolidColorBrush x:Key="Celeste.Brush.PrimaryForeground" Color="{StaticResource Celeste.Color.PrimaryForeground}" />

    <SolidColorBrush x:Key="Celeste.Brush.Secondary" Color="{StaticResource Celeste.Color.Secondary}" />
    <SolidColorBrush x:Key="Celeste.Brush.SecondaryHover" Color="{StaticResource Celeste.Color.SecondaryHover}" />
    <SolidColorBrush x:Key="Celeste.Brush.SecondaryPressed" Color="{StaticResource Celeste.Color.SecondaryPressed}" />
    <SolidColorBrush x:Key="Celeste.Brush.SecondaryForeground" Color="{StaticResource Celeste.Color.SecondaryForeground}" />

    <SolidColorBrush x:Key="Celeste.Brush.Destructive" Color="{StaticResource Celeste.Color.Destructive}" />
    <SolidColorBrush x:Key="Celeste.Brush.DestructiveHover" Color="{StaticResource Celeste.Color.DestructiveHover}" />
    <SolidColorBrush x:Key="Celeste.Brush.DestructivePressed" Color="{StaticResource Celeste.Color.DestructivePressed}" />
    <SolidColorBrush x:Key="Celeste.Brush.DestructiveForeground" Color="{StaticResource Celeste.Color.DestructiveForeground}" />

    <SolidColorBrush x:Key="Celeste.Brush.Success" Color="{StaticResource Celeste.Color.Success}" />
    <SolidColorBrush x:Key="Celeste.Brush.SuccessForeground" Color="{StaticResource Celeste.Color.SuccessForeground}" />
    <SolidColorBrush x:Key="Celeste.Brush.Warning" Color="{StaticResource Celeste.Color.Warning}" />
    <SolidColorBrush x:Key="Celeste.Brush.WarningForeground" Color="{StaticResource Celeste.Color.WarningForeground}" />

    <SolidColorBrush x:Key="Celeste.Brush.Accent" Color="{StaticResource Celeste.Color.Accent}" />
    <SolidColorBrush x:Key="Celeste.Brush.AccentForeground" Color="{StaticResource Celeste.Color.AccentForeground}" />
    <SolidColorBrush x:Key="Celeste.Brush.Muted" Color="{StaticResource Celeste.Color.Muted}" />
    <SolidColorBrush x:Key="Celeste.Brush.MutedForeground" Color="{StaticResource Celeste.Color.MutedForeground}" />

    <SolidColorBrush x:Key="Celeste.Brush.Border" Color="{StaticResource Celeste.Color.Border}" />
    <SolidColorBrush x:Key="Celeste.Brush.BorderStrong" Color="{StaticResource Celeste.Color.BorderStrong}" />
    <SolidColorBrush x:Key="Celeste.Brush.Input" Color="{StaticResource Celeste.Color.Input}" />
    <SolidColorBrush x:Key="Celeste.Brush.InputHover" Color="{StaticResource Celeste.Color.InputHover}" />
    <SolidColorBrush x:Key="Celeste.Brush.Ring" Color="{StaticResource Celeste.Color.Ring}" />

    <SolidColorBrush x:Key="Celeste.Brush.Disabled" Color="{StaticResource Celeste.Color.Disabled}" />
    <SolidColorBrush x:Key="Celeste.Brush.DisabledForeground" Color="{StaticResource Celeste.Color.DisabledForeground}" />
    <SolidColorBrush x:Key="Celeste.Brush.DisabledBorder" Color="{StaticResource Celeste.Color.DisabledBorder}" />

    <SolidColorBrush x:Key="Celeste.Brush.Overlay" Color="{StaticResource Celeste.Color.Overlay}" />
    <SolidColorBrush x:Key="Celeste.Brush.Transparent" Color="Transparent" />

    <!--  Elevation. Darker themes need a deeper shadow to separate stacked surfaces.  -->
    <DropShadowEffect x:Key="Celeste.Shadow.Sm"
                      BlurRadius="6"
                      Direction="270"
                      Opacity="0.35"
                      ShadowDepth="1"
                      Color="{StaticResource Celeste.Color.Shadow}" />
    <DropShadowEffect x:Key="Celeste.Shadow.Md"
                      BlurRadius="16"
                      Direction="270"
                      Opacity="0.5"
                      ShadowDepth="3"
                      Color="{StaticResource Celeste.Color.Shadow}" />
    <DropShadowEffect x:Key="Celeste.Shadow.Lg"
                      BlurRadius="32"
                      Direction="270"
                      Opacity="0.65"
                      ShadowDepth="8"
                      Color="{StaticResource Celeste.Color.Shadow}" />

</ResourceDictionary>
