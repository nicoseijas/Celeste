<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Celeste.Wpf.Controls">

    <Style x:Key="Celeste.Card" TargetType="{x:Type controls:Card}">
        <Setter Property="controls:ControlHelper.CornerRadius" Value="{DynamicResource Celeste.Radius.Lg}" />
        <Setter Property="Background" Value="{DynamicResource Celeste.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Celeste.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource Celeste.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Celeste.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Celeste.Brush.SurfaceForeground}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Card}">
                    <Grid>
                        <!--
                            The shadow lives on its own border. Putting an Effect on the border that
                            holds the content would blur the content itself.
                        -->
                        <Border x:Name="Shadow"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(controls:ControlHelper.CornerRadius)}" />

                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(controls:ControlHelper.CornerRadius)}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel x:Name="HeaderArea" Margin="16,14,16,0">
                                    <ContentPresenter x:Name="Header"
                                                      ContentSource="Header"
                                                      TextElement.FontSize="{DynamicResource Celeste.FontSize.Subtitle}"
                                                      TextElement.FontWeight="SemiBold" />
                                    <ContentPresenter x:Name="Description"
                                                      Margin="0,3,0,0"
                                                      Content="{TemplateBinding Description}"
                                                      TextElement.Foreground="{DynamicResource Celeste.Brush.MutedForeground}" />
                                </StackPanel>

                                <ContentPresenter x:Name="Body"
                                                  Grid.Row="1"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                                <Border x:Name="FooterArea"
                                        Grid.Row="2"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="0,1,0,0">
                                    <ContentPresenter Margin="16,12" Content="{TemplateBinding Footer}" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Header" Value="{x:Null}" />
                                <Condition Property="Description" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderArea" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="FooterArea" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Elevation" Value="Low">
                            <Setter TargetName="Shadow" Property="Effect" Value="{DynamicResource Celeste.Shadow.Sm}" />
                        </Trigger>
                        <Trigger Property="Elevation" Value="High">
                            <Setter TargetName="Shadow" Property="Effect" Value="{DynamicResource Celeste.Shadow.Lg}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Celeste.Card}" TargetType="{x:Type controls:Card}" />

</ResourceDictionary>
