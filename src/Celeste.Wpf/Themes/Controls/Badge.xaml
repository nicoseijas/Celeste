<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Celeste.Wpf.Controls">

    <Style x:Key="Celeste.Badge" TargetType="{x:Type controls:Badge}">
        <Setter Property="controls:ControlHelper.CornerRadius" Value="{DynamicResource Celeste.Radius.Md}" />
        <Setter Property="Background" Value="{DynamicResource Celeste.Brush.Muted}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource Celeste.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Celeste.FontSize.Caption}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Celeste.Brush.MutedForeground}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Badge}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(controls:ControlHelper.CornerRadius)}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Variant" Value="Primary">
                <Setter Property="Background" Value="{DynamicResource Celeste.Brush.Primary}" />
                <Setter Property="Foreground" Value="{DynamicResource Celeste.Brush.PrimaryForeground}" />
            </Trigger>
            <Trigger Property="Variant" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Celeste.Brush.Success}" />
                <Setter Property="Foreground" Value="{DynamicResource Celeste.Brush.SuccessForeground}" />
            </Trigger>
            <Trigger Property="Variant" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Celeste.Brush.Warning}" />
                <Setter Property="Foreground" Value="{DynamicResource Celeste.Brush.WarningForeground}" />
            </Trigger>
            <Trigger Property="Variant" Value="Danger">
                <Setter Property="Background" Value="{DynamicResource Celeste.Brush.Destructive}" />
                <Setter Property="Foreground" Value="{DynamicResource Celeste.Brush.DestructiveForeground}" />
            </Trigger>
            <Trigger Property="Variant" Value="Outline">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource Celeste.Brush.BorderStrong}" />
                <Setter Property="Foreground" Value="{DynamicResource Celeste.Brush.Foreground}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style BasedOn="{StaticResource Celeste.Badge}" TargetType="{x:Type controls:Badge}" />

</ResourceDictionary>
