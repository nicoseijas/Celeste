<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Celeste.Wpf.Controls">

    <Style x:Key="Celeste.ComboBoxItem" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Celeste.Brush.Foreground}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Root"
                            Margin="4,1"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Celeste.Radius.Sm}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Celeste.Brush.Secondary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Celeste.Brush.AccentForeground}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Celeste.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Celeste.Brush.DisabledForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Celeste.ComboBoxItem}" TargetType="{x:Type ComboBoxItem}" />

    <Style x:Key="Celeste.ComboBox" TargetType="{x:Type ComboBox}">
        <Setter Property="controls:ControlHelper.CornerRadius" Value="{DynamicResource Celeste.Radius.Md}" />
        <Setter Property="Background" Value="{DynamicResource Celeste.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Celeste.Brush.Input}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{DynamicResource Celeste.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Celeste.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Celeste.Brush.Foreground}" />
        <Setter Property="MinHeight" Value="{DynamicResource Celeste.Control.HeightMd}" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <Border x:Name="FocusRing"
                                Margin="-3"
                                BorderBrush="{DynamicResource Celeste.Brush.Ring}"
                                BorderThickness="2"
                                CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(controls:ControlHelper.CornerRadius)}"
                                Opacity="0" />

                        <!--  Chrome, not a control: without the opt-out the implicit ToggleButton style imposes its metrics here.  -->
                        <ToggleButton x:Name="Toggle"
                                      controls:ControlHelper.CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(controls:ControlHelper.CornerRadius)}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      ClickMode="Press"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Style="{x:Null}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(controls:ControlHelper.CornerRadius)}"
                                            SnapsToDevicePixels="True" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="Placeholder"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Celeste.Brush.MutedForeground}"
                                       IsHitTestVisible="False"
                                       Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(controls:ControlHelper.PlaceholderText)}"
                                       Visibility="Collapsed" />

                            <ContentPresenter x:Name="Selected"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              IsHitTestVisible="False" />

                            <TextBox x:Name="PART_EditableTextBox"
                                     VerticalAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Focusable="True"
                                     Foreground="{TemplateBinding Foreground}"
                                     Padding="0"
                                     Visibility="Collapsed" />

                            <Path x:Name="Chevron"
                                  Grid.Column="1"
                                  Width="10"
                                  Height="6"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center"
                                  Data="M0,0 L5,5 L10,0"
                                  IsHitTestVisible="False"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource Celeste.Brush.MutedForeground}"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.6" />
                        </Grid>

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Bottom"
                               PopupAnimation="Fade"
                               VerticalOffset="4">
                            <Border Margin="0,0,8,8"
                                    Background="{DynamicResource Celeste.Brush.SurfaceRaised}"
                                    BorderBrush="{DynamicResource Celeste.Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Celeste.Radius.Md}"
                                    Effect="{DynamicResource Celeste.Shadow.Md}"
                                    MinWidth="{Binding ActualWidth, ElementName=Toggle}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer Margin="0,4"
                                              MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Selected" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="SelectionBoxItem" Value="{x:Null}" />
                                <Condition Property="IsEditable" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Celeste.Brush.InputHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Celeste.Brush.Ring}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Chevron" Property="LayoutTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Foreground" Value="{DynamicResource Celeste.Brush.DisabledForeground}" />
                            <Setter TargetName="Toggle" Property="Background" Value="{DynamicResource Celeste.Brush.Disabled}" />
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Celeste.Brush.DisabledBorder}" />
                            <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Celeste.Brush.DisabledForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Celeste.ComboBox}" TargetType="{x:Type ComboBox}" />

</ResourceDictionary>
