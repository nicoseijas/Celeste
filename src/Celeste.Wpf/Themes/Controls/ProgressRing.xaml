<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Celeste.Wpf.Controls">

    <Style x:Key="Celeste.ProgressRing" TargetType="{x:Type controls:ProgressRing}">
        <Setter Property="Foreground" Value="{DynamicResource Celeste.Brush.Primary}" />
        <Setter Property="Height" Value="24" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ProgressRing}">
                    <Grid x:Name="Root">
                        <!--  Track: the full circle, dimmed.  -->
                        <Ellipse Margin="2"
                                 Opacity="0.18"
                                 Stroke="{TemplateBinding Foreground}"
                                 StrokeThickness="{TemplateBinding StrokeThickness}" />

                        <!--  Indicator: a 270-degree arc that spins.  -->
                        <Path x:Name="Arc"
                              Margin="2"
                              Data="M12,2 A10,10 0 1 1 2,12"
                              RenderTransformOrigin="0.5,0.5"
                              Stretch="Uniform"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeEndLineCap="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="{TemplateBinding StrokeThickness}">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="Spin" Angle="0" />
                            </Path.RenderTransform>
                        </Path>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SpinStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Spin"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0"
                                                         To="360"
                                                         Duration="0:0:1.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="Root" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Celeste.ProgressRing}" TargetType="{x:Type controls:ProgressRing}" />

</ResourceDictionary>
