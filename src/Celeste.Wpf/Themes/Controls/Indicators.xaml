<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Celeste.Wpf.Controls">

    <!--  ===================  ProgressBar  ===================  -->
    <Style x:Key="Celeste.ProgressBar" TargetType="{x:Type ProgressBar}">
        <Setter Property="Background" Value="{DynamicResource Celeste.Brush.Muted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Celeste.Brush.Primary}" />
        <Setter Property="Height" Value="6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border x:Name="Track"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Celeste.Radius.Pill}"
                            ClipToBounds="True"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Rectangle x:Name="PART_Track" Fill="Transparent" />
                            <Rectangle x:Name="PART_Indicator"
                                       HorizontalAlignment="Left"
                                       Fill="{TemplateBinding Foreground}"
                                       RadiusX="3"
                                       RadiusY="3" />
                            <!--
                                Indeterminate mode pulses a full-width bar instead of sliding a
                                chip across the track: a sliding animation needs the track width as
                                its To value, and a Storyboard cannot carry a binding (it is frozen).
                            -->
                            <Rectangle x:Name="Pulse"
                                       Fill="{TemplateBinding Foreground}"
                                       Opacity="0.3"
                                       RadiusX="3"
                                       RadiusY="3"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Pulse" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!--
                            The pulse is separate from the setters above, so that turning animations
                            off in Windows leaves a filled track rather than an empty determinate bar
                            reading zero. The bar still says the amount is unknown; it just stops
                            breathing.
                        -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsIndeterminate, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="PulseStoryboard">
                                    <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Pulse"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0.25"
                                                         To="0.9"
                                                         Duration="0:0:0.9">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="PulseStoryboard" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Celeste.ProgressBar}" TargetType="{x:Type ProgressBar}" />

    <!--  ===================  Slider  ===================  -->
    <Style x:Key="Celeste.Slider.Thumb" TargetType="{x:Type Thumb}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="16" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid>
                        <Ellipse x:Name="Halo"
                                 Margin="-5"
                                 Fill="{DynamicResource Celeste.Brush.Primary}"
                                 Opacity="0" />
                        <Ellipse x:Name="Knob"
                                 Fill="{DynamicResource Celeste.Brush.Surface}"
                                 Stroke="{DynamicResource Celeste.Brush.Primary}"
                                 StrokeThickness="2" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.15" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.25" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Knob" Property="Stroke" Value="{DynamicResource Celeste.Brush.DisabledForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Celeste.Slider" TargetType="{x:Type Slider}">
        <Setter Property="Background" Value="{DynamicResource Celeste.Brush.Muted}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Celeste.Brush.Primary}" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid Background="Transparent">
                        <!--
                            Around the whole control rather than around the thumb. The thumb is not
                            focusable — the Slider is — and the ring lives in the thumb's own
                            template, out of reach of a trigger here. A ring on the control is also
                            what the user is looking for: the arrow keys move the slider, not a knob.
                        -->
                        <Border x:Name="FocusRing"
                                Margin="-3"
                                BorderBrush="{DynamicResource Celeste.Brush.Ring}"
                                BorderThickness="2"
                                CornerRadius="{DynamicResource Celeste.Radius.Sm}"
                                Opacity="0"
                                SnapsToDevicePixels="True" />

                        <Border Height="4"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2" />
                        <Border x:Name="Fill"
                                Width="{Binding ActualWidth, ElementName=Decrease}"
                                Height="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="2" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="Decrease"
                                              Command="Slider.DecreaseLarge"
                                              Focusable="False"
                                              IsTabStop="False"
                                              Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Celeste.Slider.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Focusable="False"
                                              IsTabStop="False"
                                              Opacity="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Celeste.Brush.DisabledForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Celeste.Slider}" TargetType="{x:Type Slider}" />

    <!--  ===================  ToolTip  ===================  -->
    <Style x:Key="Celeste.ToolTip" TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource Celeste.Brush.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Celeste.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource Celeste.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Celeste.FontSize.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Celeste.Brush.Foreground}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <!--  No drop shadow: the tooltip popup is not transparency-enabled, so a shadow would paint on an opaque rectangle.  -->
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Celeste.Radius.Sm}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Celeste.ToolTip}" TargetType="{x:Type ToolTip}" />

</ResourceDictionary>
