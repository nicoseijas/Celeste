<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Celeste.Wpf.Controls">

    <Style x:Key="Celeste.ToggleSwitch" TargetType="{x:Type controls:ToggleSwitch}">
        <Setter Property="Background" Value="{DynamicResource Celeste.Brush.Input}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{DynamicResource Celeste.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Celeste.FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Celeste.Brush.Foreground}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ToggleSwitch}">
                    <StackPanel Background="Transparent" Orientation="Horizontal">
                        <Grid Width="40" Height="22" VerticalAlignment="Center">
                            <Border x:Name="FocusRing"
                                    Margin="-3"
                                    BorderBrush="{DynamicResource Celeste.Brush.Ring}"
                                    BorderThickness="2"
                                    CornerRadius="14"
                                    Opacity="0" />
                            <Border x:Name="Track"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="11" />
                            <!--
                                The thumb's resting position is its Margin, not a transform: a
                                Setter can express the static on/off state, and the animation only
                                supplies the motion between them. A transform-only switch renders
                                with the thumb on the left until its storyboard has run.
                            -->
                            <Ellipse x:Name="Thumb"
                                     Width="16"
                                     Height="16"
                                     Margin="3,0,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource Celeste.Brush.Surface}" />
                        </Grid>

                        <ContentPresenter x:Name="Label"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Celeste.Brush.Primary}" />
                            <Setter TargetName="Thumb" Property="Margin" Value="21,0,0,0" />
                        </Trigger>

                        <!--
                            The slide is the setter above made gradual, which is why it is a separate
                            trigger: a user who has turned animations off in Windows still gets the
                            switch moving, just without the travel. From is explicit because the
                            setter has already applied the destination and there would be nothing left
                            to animate from.
                        -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ThicknessAnimation Storyboard.TargetName="Thumb"
                                                            Storyboard.TargetProperty="Margin"
                                                            From="3,0,0,0"
                                                            To="21,0,0,0"
                                                            Duration="0:0:0.15">
                                            <ThicknessAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ThicknessAnimation Storyboard.TargetName="Thumb"
                                                            Storyboard.TargetProperty="Margin"
                                                            From="21,0,0,0"
                                                            To="3,0,0,0"
                                                            Duration="0:0:0.15">
                                            <ThicknessAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Celeste.Brush.PrimaryHover}" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Celeste.Brush.InputHover}" />
                        </MultiTrigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>

                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Foreground" Value="{DynamicResource Celeste.Brush.DisabledForeground}" />
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Celeste.Brush.Disabled}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Celeste.Brush.DisabledBorder}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Celeste.Brush.DisabledForeground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource Celeste.ToggleSwitch}" TargetType="{x:Type controls:ToggleSwitch}" />

</ResourceDictionary>
