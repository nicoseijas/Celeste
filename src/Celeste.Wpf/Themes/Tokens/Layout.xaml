<!--
    Celeste — layout tokens. Theme-independent: these do not change between light and dark,
    so they live outside the swappable theme dictionaries.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--  Spacing scale (4px base)  -->
    <sys:Double x:Key="Celeste.Space.Xs">4</sys:Double>
    <sys:Double x:Key="Celeste.Space.Sm">8</sys:Double>
    <sys:Double x:Key="Celeste.Space.Md">12</sys:Double>
    <sys:Double x:Key="Celeste.Space.Lg">16</sys:Double>
    <sys:Double x:Key="Celeste.Space.Xl">24</sys:Double>
    <sys:Double x:Key="Celeste.Space.Xxl">32</sys:Double>

    <!--  Corner radius  -->
    <CornerRadius x:Key="Celeste.Radius.None">0</CornerRadius>
    <CornerRadius x:Key="Celeste.Radius.Sm">4</CornerRadius>
    <CornerRadius x:Key="Celeste.Radius.Md">6</CornerRadius>
    <CornerRadius x:Key="Celeste.Radius.Lg">10</CornerRadius>
    <CornerRadius x:Key="Celeste.Radius.Xl">14</CornerRadius>
    <CornerRadius x:Key="Celeste.Radius.Pill">999</CornerRadius>

    <!--  Border widths  -->
    <Thickness x:Key="Celeste.BorderThickness.Thin">1</Thickness>
    <Thickness x:Key="Celeste.BorderThickness.Thick">2</Thickness>

    <!--  Control metrics  -->
    <sys:Double x:Key="Celeste.Control.HeightSm">28</sys:Double>
    <sys:Double x:Key="Celeste.Control.HeightMd">34</sys:Double>
    <sys:Double x:Key="Celeste.Control.HeightLg">42</sys:Double>
    <Thickness x:Key="Celeste.Control.PaddingSm">10,4</Thickness>
    <Thickness x:Key="Celeste.Control.PaddingMd">14,6</Thickness>
    <Thickness x:Key="Celeste.Control.PaddingLg">20,10</Thickness>

    <!--  Sidebar metrics  -->
    <sys:Double x:Key="Celeste.Sidebar.ExpandedWidth">248</sys:Double>
    <sys:Double x:Key="Celeste.Sidebar.CollapsedWidth">56</sys:Double>
    <sys:Double x:Key="Celeste.Sidebar.ItemHeight">36</sys:Double>
    <sys:Double x:Key="Celeste.Sidebar.IconSize">18</sys:Double>

    <!--  Focus ring  -->
    <sys:Double x:Key="Celeste.Focus.RingThickness">2</sys:Double>
    <sys:Double x:Key="Celeste.Focus.RingOffset">2</sys:Double>

    <!--  Motion. Short and consistent; nothing here should outlast a click.  -->
    <Duration x:Key="Celeste.Duration.Instant">0:0:0.08</Duration>
    <Duration x:Key="Celeste.Duration.Fast">0:0:0.15</Duration>
    <Duration x:Key="Celeste.Duration.Normal">0:0:0.25</Duration>

</ResourceDictionary>
