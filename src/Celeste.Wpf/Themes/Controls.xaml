<!--
    Celeste — every control style, plus the theme-independent tokens they depend on.
    Merge this once, via <celeste:ControlsDictionary />, after a <celeste:ThemesDictionary />.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Celeste.Wpf;component/Themes/Tokens/Layout.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Celeste.Wpf;component/Themes/Tokens/Typography.xaml" />

        <ResourceDictionary Source="pack://application:,,,/Celeste.Wpf;component/Themes/Controls/Window.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Celeste.Wpf;component/Themes/Controls/Text.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Celeste.Wpf;component/Themes/Controls/Button.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Celeste.Wpf;component/Themes/Controls/TextInput.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Celeste.Wpf;component/Themes/Controls/Selection.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Celeste.Wpf;component/Themes/Controls/ComboBox.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Celeste.Wpf;component/Themes/Controls/Scrolling.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Celeste.Wpf;component/Themes/Controls/Indicators.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Celeste.Wpf;component/Themes/Controls/Collections.xaml" />

        <ResourceDictionary Source="pack://application:,,,/Celeste.Wpf;component/Themes/Controls/Card.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Celeste.Wpf;component/Themes/Controls/Badge.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Celeste.Wpf;component/Themes/Controls/ToggleSwitch.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Celeste.Wpf;component/Themes/Controls/ProgressRing.xaml" />
        <ResourceDictionary Source="pack://application:,,,/Celeste.Wpf;component/Themes/Controls/Sidebar.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
